# The privileged hydration helper.
#
# Holds CAP_SYS_ADMIN and nothing else. It never opens a network socket, never
# sees a credential, and never accepts a path from the unprivileged side — the
# protocol between them carries an inode and bytes, and has no field that could
# name a destination.
[Unit]
Description=Hydration helper (privileged)
Documentation=https://github.com/franzjeger/HydrationAPI

# The load-bearing line, and the reason this unit file matters at all.
#
# Two of the three ways hydration can fail are handled inside the process: the
# supervisor answers for a worker that dies, including one that dies holding an
# event. The third — both halves going at once, an OOM kill of the whole cgroup,
# a panic — cannot be. Nothing that is dead can deny a read.
#
# So the mount goes with the helper. With no helper the files are *unreachable*,
# which is a bad afternoon; without this line they are readable and full of
# zeros, which is a restore from backup.
# RequiresMountsFor, not BindsTo. Measured, because the difference is invisible
# in the unit file and total in practice.
#
# Both stop this service when the mount goes away, which is the safety property:
# a marked mount must not outlive the process that answers its events, and a
# mount that is replaced without being marked would let every read through
# unprotected (§6.4a).
#
# They differ on recovery. The helper detaches its own mount on the way out
# (§6a-bis), and with BindsTo= — or with a plain Requires= — systemd reads the
# resulting stop as deliberate and suppresses the restart entirely: measured
# `NRestarts=0`, `Result=success`, both units inactive, permanently. The
# deployment goes down and stays down. With RequiresMountsFor= the restart
# happens and pulls the mount back up: measured three times out of three, both
# units active, and an administrator's `umount` still stops the service.
RequiresMountsFor=/home/CHANGE-ME/OneDrive

# systemd's default start-rate limit is 5 starts in 10s, and a unit that trips it
# is left *dead* — which for this unit means a mount with no helper, the one
# state this deployment must not reach quietly. `hydrationd.path` makes the
# boot-time storm this was written for impossible, so nothing should reach the
# limit any more; it stays because being wrong about that costs the deployment
# and turning it off costs nothing.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/hydrationd --mount /home/CHANGE-ME/OneDrive --socket /run/user/CHANGE-ME/hydration-sync.sock --peer-uid CHANGE-ME
# The helper exits non-zero when it cannot recover: a wedged fetcher, or a sync
# daemon that went away and left it with no way to fetch anything. Before
# exiting it detaches the mount itself, because exiting first would close the
# fanotify group and a marked mount with no group fails *open* — every
# placeholder becomes a source of zeros.
#
# The mount coming down is the helper's own `umount2(MNT_DETACH)`, not a systemd
# dependency: the dependency here runs the other way, and makes this service
# depend on the mount rather than the reverse. What systemd contributes is the
# recovery — this restarts, and RequiresMountsFor= brings the mount back with
# it. Measured; see DESIGN.md §8b.
#
# A client restart is survived in-process: the helper reconnects to the socket
# and re-checks the peer's uid, so the mount never comes down for it. Measured
# before that existed (2026-08-12): "the pair is rebuilt by systemd" meant five
# minutes of EIO and then this unit tearing the mount down, because nothing
# restarts a *system* unit when a *user* unit comes back. The teardown below is
# now only for a client that stays gone past the helper's give-up limit.
Restart=always
RestartSec=1

# Everything a helper this small does not need.
# NO DIRECTIVE HERE MAY CREATE A MOUNT NAMESPACE.
#
# This is the constraint the rest of the sandboxing has to fit around, and it is
# not obvious from any of the directive names. `fanotify_mark(FAN_MARK_MOUNT)`
# marks the `vfsmount` in the *caller's* mount namespace: give this unit one of
# its own and it marks a private copy, logs that it is watching, and every read
# from the user's session goes through an unmarked mount and returns the zeros a
# placeholder is made of. Measured on a real deployment — a 3,557-byte file read
# back 3,557 zero bytes with the unit reporting active throughout.
#
# Measured, each of these *alone* is enough to cause it. None may be used:
#
#   PrivateTmp=  PrivateNetwork=  ProtectKernelTunables=
#   ProtectControlGroups=  ProtectKernelModules=
#
# This earlier shipped with all five. `hydrationd` now refuses to start when it
# finds itself in a namespace of its own (`selfcheck::reach`), so the mistake is
# loud rather than silent — but a unit that trips that check is still a unit that
# does not run.
User=root

# CAP_SYS_ADMIN is what fanotify needs. CAP_DAC_OVERRIDE is what "root" normally
# means, and dropping it costs this process access to its own mount: a sync root
# inside a 0700 home returns EACCES from `stat`, and the sync daemon's socket is
# 0600, which needs write permission to connect to. Both were measured.
#
# Narrow it to CAP_SYS_ADMIN alone only if the sync root, every directory above
# it, and the socket are all traversable by root without the DAC bypass — which
# on a single-user desktop they are not.
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE

NoNewPrivileges=yes
# The network denial, done without a namespace. This process has no business
# reaching a network, and if it ever tries, that is the incident. This replaces
# PrivateNetwork=yes, which achieves the same thing and takes a mount namespace
# with it — systemd mounts a private /sys for the network namespace.
RestrictAddressFamilies=AF_UNIX
# Seccomp filters and personality bits. None of these create a namespace.
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# The supervisor exists to outlive the worker. Letting the kernel choose it as
# an OOM victim would remove the thing that makes failures safe, at exactly the
# moment things are going wrong.
OOMScoreAdjust=-900

# No [Install] section, on purpose.
#
# Nothing may start this at boot. Between boot and the user's login there is no
# sync daemon to answer events, and a helper that started anyway would pull the
# mount up via RequiresMountsFor= and then exit for want of a peer — a mount full
# of placeholders with nothing answering for them, which is the §6a failure this
# whole design exists to prevent. With Restart=always it would do that in a loop.
#
# `hydrationd.path` is the only trigger: it starts this once, when the socket
# appears. Enable that, not this.
