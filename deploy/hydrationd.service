# The privileged hydration helper.
#
# Holds CAP_SYS_ADMIN and nothing else. It never opens a network socket, never
# sees a credential, and never accepts a path from the unprivileged side — the
# protocol between them carries an inode and bytes, and has no field that could
# name a destination.
[Unit]
Description=Hydration helper (privileged)
Documentation=https://github.com/franzjeger/HydrationAPI

# The load-bearing line, and the reason this unit file matters at all.
#
# Two of the three ways hydration can fail are handled inside the process: the
# supervisor answers for a worker that dies, including one that dies holding an
# event. The third — both halves going at once, an OOM kill of the whole cgroup,
# a panic — cannot be. Nothing that is dead can deny a read.
#
# So the mount goes with the helper. With no helper the files are *unreachable*,
# which is a bad afternoon; without this line they are readable and full of
# zeros, which is a restore from backup.
# BindsTo implies Requires, so starting this pulls the mount in; and the mount
# going away takes this with it, which is what stops a marked mount from
# outliving the process that answers its events.
BindsTo=hydration-mount.mount
After=hydration-mount.mount
StopPropagatedFrom=hydration-mount.mount

[Service]
Type=simple
ExecStart=/usr/local/bin/hydrationd --mount /home/CHANGE-ME/OneDrive --socket /run/user/CHANGE-ME/hydration-sync.sock --peer-uid CHANGE-ME
# The helper exits non-zero when it cannot recover: a wedged fetcher, or a sync
# daemon that went away and left it with no way to fetch anything. Before
# exiting it detaches the mount itself, because exiting first would close the
# fanotify group and a marked mount with no group fails *open* — every
# placeholder becomes a source of zeros.
#
# The intended chain is: helper detaches and exits non-zero -> Restart=always
# brings it back -> BindsTo pulls the mount up again -> it reconnects to the
# sync daemon on startup. That is how a client restart is survived; there is no
# in-process reconnect path.
#
# NOT VERIFIED against a running systemd (see DESIGN.md §9). The uncertainty is
# whether systemd treats the BindsTo-driven stop as a deliberate stop, which
# would suppress the restart, rather than as the failure the exit code reports.
# If it does, the unit needs an explicit restart path rather than this chain.
Restart=always
RestartSec=1

# Everything a helper this small does not need.
User=root
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# PrivateNetwork is not hardening theatre here: this process has no business
# reaching a network, and if it ever tries, that is the incident.

# The supervisor exists to outlive the worker. Letting the kernel choose it as
# an OOM victim would remove the thing that makes failures safe, at exactly the
# moment things are going wrong.
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
